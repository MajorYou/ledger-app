# ============================================================
# 只追踪源代码，以下全部排除
# ============================================================

# ---- 依赖 (由 package.json 管理) ----
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---- 构建产物 ----
/.next/
/out/
/build
/.turbo

# ---- Next.js 自动生成 ----
next-env.d.ts

# ---- TypeScript 编译缓存 ----
*.tsbuildinfo

# ---- 环境变量 & 密钥 ----
.env*
!.env.example

# ---- SQLite 数据库（含用户数据、设置、API Key） ----
prisma/*.db
prisma/*.db-journal

# ---- 日志 ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- 测试产物 ----
/coverage

# ---- 应用日志 ----
/logs/

# ---- 部署平台缓存 ----
.vercel
.netlify

# ---- 系统文件 ----
.DS_Store
Thumbs.db
*.pem

# ---- IDE 配置 ----
.idea/
.vscode/
*.swp
*.swo
