generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---- 用户 ----
model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  isFamilyHost Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  accounts       Account[]
  transactions   Transaction[]
  createdInvites FamilyInvite[] @relation("InviteCreator")
  usedInvite     FamilyInvite?  @relation("InviteUsedBy")
}

// ---- 家庭邀请码 ----
model FamilyInvite {
  id        String   @id @default(cuid())
  code      String   @unique
  creatorId String
  creator   User     @relation("InviteCreator", fields: [creatorId], references: [id])
  usedById  String?  @unique
  usedBy    User?    @relation("InviteUsedBy", fields: [usedById], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  expiresAt DateTime?
}

// ---- 支付账户 ----
model Account {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  name        String
  type        String   @default("savings") // savings / cash / credit / prepaid / investment
  institution String?  // 银行/平台名称，如"招商银行"、"支付宝"
  last4Digits String?  // 银行卡后四位，用于跨平台匹配
  currency    String   @default("CNY")
  balance     Float    @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sourceTransactions Transaction[] @relation("SourceAccount")
  destTransactions   Transaction[] @relation("DestAccount")

  @@unique([userId, institution, last4Digits])
}

// ---- 账本（支持层级） ----
model Ledger {
  id        String    @id @default(cuid())
  name      String    @unique
  parentId  String?
  parent    Ledger?   @relation("LedgerHierarchy", fields: [parentId], references: [id])
  children  Ledger[]  @relation("LedgerHierarchy")
  type      String    @default("daily") // daily / travel / project / annual
  color     String    @default("#3b82f6")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  transactionLedgers TransactionLedger[]
}

// ---- 分类（支持层级） ----
model Category {
  id        String     @id @default(cuid())
  name      String
  type      String     @default("expense") // expense / income
  parentId  String?
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  icon      String     @default("📦")
  color     String     @default("#6b7280")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  transactions       Transaction[]
  classificationCache ClassificationCache[]
}

// ---- 交易记录 ----
model Transaction {
  id              String    @id @default(cuid())
  type            String    @default("expense") // expense / income / transfer
  amount          Float
  merchant        String    @default("")
  description     String    @default("")
  transactionTime DateTime  @default(now())
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id])
  sourceAccountId String?   @map("accountId")
  sourceAccount   Account?  @relation("SourceAccount", fields: [sourceAccountId], references: [id])
  toAccountId     String?
  toAccount       Account?  @relation("DestAccount", fields: [toAccountId], references: [id])
  channel         String?   // 支付通道：支付宝/微信/云闪付
  externalOrderId String?   // 外部订单号，用于精确去重
  createdById     String
  createdBy       User      @relation(fields: [createdById], references: [id])
  isConfirmed     Boolean   @default(true)
  llmClassified   Boolean   @default(false)
  duplicateGroupId String?
  importRecordId  String?
  importRecord    ImportRecord? @relation(fields: [importRecordId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  transactionLedgers TransactionLedger[]

  @@index([externalOrderId])
}

// ---- 交易↔账本 多对多 ----
model TransactionLedger {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  ledgerId      String
  ledger        Ledger      @relation(fields: [ledgerId], references: [id], onDelete: Cascade)

  @@unique([transactionId, ledgerId])
}

// ---- 导入记录 ----
model ImportRecord {
  id              String   @id @default(cuid())
  sourceType      String   // csv / pdf / manual
  fileName        String?
  rawContentHash  String?
  parsedJson      String?
  createdAt       DateTime @default(now())

  transactions Transaction[]
}

// ---- AI 分类缓存 ----
model ClassificationCache {
  id                  String   @id @default(cuid())
  merchantPattern     String
  suggestedCategoryId String
  category            Category @relation(fields: [suggestedCategoryId], references: [id])
  confidence          Float    @default(0)
  hitCount            Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([merchantPattern])
}

// ---- 用户规则引擎 ----
model UserRule {
  id        String   @id @default(cuid())
  userId    String
  name      String   // 规则名称，如"食堂归三餐"
  condition String   // JSON: { field: "merchant", operator: "contains", value: "食堂" }
  action    String   // JSON: { type: "reclassify", params: { categoryName: "三餐" } }
  priority  Int      @default(0)  // 优先级，数字越大越优先
  isActive  Boolean  @default(true)
  source    String   @default("manual") // 'auto' | 'manual'
  confidence Float   @default(1.0) // 置信度，自动学习的规则会随纠正次数变化
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId])
}

// ---- 操作模板 ----
model OperationTemplate {
  id            String   @id @default(cuid())
  userId        String
  name          String   // 模板名称，如"月度固定支出"
  triggerPhrases String  // JSON 数组: ["月度固定支出", "记固定支出", "每月固定开支"]
  operations    String   // JSON 数组: 每笔交易的操作定义
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([userId])
}

// ---- 系统设置（键值对） ----
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
